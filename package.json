{
  "name": "ntuboa",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:backend": "backend\\.venv\\Scripts\\python.exe -m pytest backend -q",
    "test:integration": "npm run test:backend",
    "test:all": "npm test && npm run test:integration"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "expo": "~57.0.26",
    "expo-apple-authentication": "~57.0.2",
    "expo-auth-session": "~57.0.14",
    "expo-checkbox": "~57.0.0",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~15.0.2",
    "expo-modules-core": "~57.0.0",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.16.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "zustand": "^5.0.15"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    },
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.js"
    ],
    "moduleNameMapper": {
      "^expo-secure-store$": "<rootDir>/__tests__/support/expoSecureStoreMock.js"
    }
  },
  "private": true,
  "devDependencies": {
    "expo-doctor": "^1.18.22",
    "jest": "~29.7.0",
    "jest-expo": "^57.0.5",
    "react-native-svg-transformer": "^1.5.3"
  }
}
